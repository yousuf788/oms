# order-process cluster config — single-machine setup (all services on Amit's machine)
# All three S2 replicas on the same host, differentiated by port.

BIND_HOST=0.0.0.0

# ---- Node 1 (Nitin) ----
NODE1_NAME=Nitin
NODE1_HOST=10.10.1.121
NODE1_RAFT_PORT=6001
NODE1_ORDER_PORT=7001
NODE1_HEALTH_PORT=6101
NODE1_REPLAY_PORT=6201

# ---- Node 2 (Amit) ----
NODE2_NAME=Amit
NODE2_HOST=10.10.0.56
NODE2_RAFT_PORT=6002
NODE2_ORDER_PORT=7002
NODE2_HEALTH_PORT=6102
NODE2_REPLAY_PORT=6202

# ---- Node 3 (Yousuf) ----
NODE3_NAME=Yousuf
NODE3_HOST=10.10.1.69
NODE3_RAFT_PORT=6003
NODE3_ORDER_PORT=7003
NODE3_HEALTH_PORT=6103
NODE3_REPLAY_PORT=6203

# order-receiver on the same machine
S3_HOST=10.10.0.56
S3_PORT=8001

# order-sending's replay listener (S1<->S2 gap-recovery protocol) — inferred
# as co-located with Node 3 (Yousuf) per docs/HLD.md's "SERVER 1
# (10.10.1.69)" description. CONFIRM/ADJUST this to wherever order-sending
# actually runs.
S1_HOST=10.10.1.69
S1_REPLAY_PORT=9001

HEARTBEAT_INTERVAL_MS=50
ELECTION_TIMEOUT_MIN_MS=150
ELECTION_TIMEOUT_MAX_MS=300

# Single-node leader promotion
ALLOW_SINGLE_NODE_LEADER=true
PEER_SILENT_MS=2000

# order-monitoring on the same machine
monitoring_HOST=10.10.0.56
monitoring_PORT=9101
monitoring_TIMEOUT_MS=1500
monitoring_RETRY_INTERVAL_MS=2000
REQUIRE_monitoring_FOR_SINGLE_NODE_LEADER=true

# ── HMAC Authentication (REQUIRED on all nodes) ──────────────────────────────
CLUSTER_HMAC_KEY=b3c85adea50f9c53173a6adace2568825f34c46645c4c0711eb45b96dad3246e
monitoring_HMAC_KEY=679a9310c506a091ab103253251f9032d96db15ca67b63569fe20b93b35571d8
