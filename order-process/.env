# order-process cluster config
# Copy to `.env` on every order-process machine (same content).

BIND_HOST=0.0.0.0

# ---- Node 1 (Nitin) — second test machine ----
NODE1_NAME=Nitin
NODE1_HOST=10.10.1.121
NODE1_RAFT_PORT=6001
NODE1_ORDER_PORT=7001
NODE1_HEALTH_PORT=6101

# ---- Node 2 (Amit) — this machine ----
NODE2_NAME=Amit
NODE2_HOST=172.16.13.181
NODE2_RAFT_PORT=6002
NODE2_ORDER_PORT=7002
NODE2_HEALTH_PORT=6102

# ---- Node 3 (Yousuf) — not started for this 2-machine test, left configured but unused ----
NODE3_NAME=Yousuf
NODE3_HOST=172.16.12.252
NODE3_RAFT_PORT=6003
NODE3_ORDER_PORT=7003
NODE3_HEALTH_PORT=6103

# order-receiver runs on this machine (Amit) for this test
S3_HOST=172.16.13.181
S3_PORT=8001

HEARTBEAT_INTERVAL_MS=50
# Widened from 150-300ms: measured cross-machine RTT on this link spikes to
# ~300-500ms, which is longer than the old timeout window and was causing
# spurious re-elections. 800-1500ms tolerates the link's latency.
ELECTION_TIMEOUT_MIN_MS=800
ELECTION_TIMEOUT_MAX_MS=1500

# If Nitin+Amit stop, Yousuf can become leader alone after peers are silent this long
# AND the witness below corroborates that both peers are genuinely unreachable — a
# local timeout alone is never sufficient (see order-witness/).
ALLOW_SINGLE_NODE_LEADER=true
PEER_SILENT_MS=2000

# order-witness runs on Yousuf's machine (idle in this 2-machine test) so it fails
# independently of both live nodes. Must match order-witness/.env's own values.
WITNESS_HOST=172.16.12.252
WITNESS_PORT=9101
WITNESS_TIMEOUT_MS=1500
WITNESS_RETRY_INTERVAL_MS=2000
# false only disables the witness requirement (legacy blind-timeout self-promotion);
# see order-process/.env.example for the no-witness local-demo profile.
REQUIRE_WITNESS_FOR_SINGLE_NODE_LEADER=true

# ── HMAC Authentication (REQUIRED on all nodes) ──────────────────────────────
# CLUSTER_HMAC_KEY: signs Aeron order messages (S1→S2) + all Raft UDP messages.
# Must be IDENTICAL on order-sending AND every order-process node.
CLUSTER_HMAC_KEY=b3c85adea50f9c53173a6adace2568825f34c46645c4c0711eb45b96dad3246e

# WITNESS_HMAC_KEY: signs corroboration messages with order-witness.
# Must be IDENTICAL on order-process AND order-witness.
WITNESS_HMAC_KEY=679a9310c506a091ab103253251f9032d96db15ca67b63569fe20b93b35571d8
