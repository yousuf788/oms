# order-process cluster config
# Copy to `.env` on every order-process machine (same content).

BIND_HOST=0.0.0.0

# ---- Node 1 (Vivek) — second test machine ----
NODE1_NAME=Vivek
NODE1_HOST=10.10.1.121
NODE1_RAFT_PORT=6001
NODE1_ORDER_PORT=7001

# ---- Node 2 (Amit) — this machine ----
NODE2_NAME=Amit
NODE2_HOST=172.16.13.181
NODE2_RAFT_PORT=6002
NODE2_ORDER_PORT=7002

# ---- Node 3 (Yousuf) — not started for this 2-machine test, left configured but unused ----
NODE3_NAME=Yousuf
NODE3_HOST=172.16.12.252
NODE3_RAFT_PORT=6003
NODE3_ORDER_PORT=7003

# order-receiver runs on this machine (Amit) for this test
S3_HOST=172.16.13.181
S3_PORT=8001

HEARTBEAT_INTERVAL_MS=50
# Widened from 150-300ms: measured cross-machine RTT on this link spikes to
# ~300-500ms, which is longer than the old timeout window and was causing
# spurious re-elections. 800-1500ms tolerates the link's latency.
ELECTION_TIMEOUT_MIN_MS=800
ELECTION_TIMEOUT_MAX_MS=1500

# If Vivek+Amit stop, Yousuf can become leader alone after peers are silent this long
ALLOW_SINGLE_NODE_LEADER=true
PEER_SILENT_MS=2000
