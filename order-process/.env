# order-process cluster config
# Paste each computer's IP + ports below.
# Copy this file to `.env` on every order-process machine (same content).

# Local listen address (0.0.0.0 = all interfaces)
BIND_HOST=0.0.0.0

# ---- Node 1 (e.g. Vivek) ----
NODE1_HOST=127.0.0.1
NODE1_RAFT_PORT=6001
NODE1_ORDER_PORT=7001

# ---- Node 2 (e.g. Amit) ----
NODE2_HOST=127.0.0.1
NODE2_RAFT_PORT=6002
NODE2_ORDER_PORT=7002

# ---- Node 3 (e.g. Nitin) ----
NODE3_HOST=127.0.0.1
NODE3_RAFT_PORT=6003
NODE3_ORDER_PORT=7003

# Where leader sends final results (order-receiver machine)
S3_HOST=127.0.0.1
S3_PORT=8001

# Optional Raft timing
HEARTBEAT_INTERVAL_MS=100
ELECTION_TIMEOUT_MIN_MS=300
ELECTION_TIMEOUT_MAX_MS=600
