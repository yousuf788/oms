# Single-computer example — all services on one machine (localhost).
# Copy to `.env` for local dev: cp .env.example .env
# Run three order-process terminals with NODE_ID=1, 2, 3.

BIND_HOST=0.0.0.0

# All three S2 replicas on the same host
NODE1_HOST=127.0.0.1
NODE1_NAME=Nitin
NODE1_RAFT_PORT=6001
NODE1_ORDER_PORT=7001
NODE1_HEALTH_PORT=6101
NODE1_REPLAY_PORT=6201

NODE2_HOST=127.0.0.1
NODE2_NAME=Amit
NODE2_RAFT_PORT=6002
NODE2_ORDER_PORT=7002
NODE2_HEALTH_PORT=6102
NODE2_REPLAY_PORT=6202

NODE3_HOST=127.0.0.1
NODE3_NAME=Yousuf
NODE3_RAFT_PORT=6003
NODE3_ORDER_PORT=7003
NODE3_HEALTH_PORT=6103
NODE3_REPLAY_PORT=6203

# order-receiver on the same machine
S3_HOST=127.0.0.1
S3_PORT=8001

# order-sending's replay listener (S1<->S2 gap-recovery protocol) — matches
# order-sending/.env.example's SENDER_BIND_PORT.
S1_HOST=127.0.0.1
S1_REPLAY_PORT=9001

HEARTBEAT_INTERVAL_MS=50
ELECTION_TIMEOUT_MIN_MS=150
ELECTION_TIMEOUT_MAX_MS=300

# This demo profile doesn't run order-monitoring, so single-node self-promotion falls
# back to the legacy blind-timeout behavior (identical to before monitoring support was
# added). To try the monitoring-corroborated path locally: also run
# `cd order-monitoring && cp .env.example .env && cargo run --release`, set
# monitoring_HOST=127.0.0.1 below, and flip this to true.
REQUIRE_monitoring_FOR_SINGLE_NODE_LEADER=false

# ── HMAC Authentication (REQUIRED on all nodes) ──────────────────────────────
# CLUSTER_HMAC_KEY authenticates Aeron order messages (S1→S2) and all Raft
# control messages between S2 nodes. Must be IDENTICAL on order-sending AND
# every order-process replica.
#
# monitoring_HMAC_KEY authenticates corroboration messages between order-process
# nodes and the order-monitoring service. Must be IDENTICAL on order-process AND
# order-monitoring. Keep it separate from CLUSTER_HMAC_KEY so the monitoring never
# has access to the Raft signing material.
#
# Generate both keys once, then copy them to every machine's .env:
#   openssl rand -hex 32   # run twice — one for each key
CLUSTER_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32
monitoring_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# ── Optional Aeron channel tuning (all unset by default = Media Driver defaults) ──
# Appended to every publication/subscription URI this crate builds (see
# config.rs::aeron_channel_tuning()). Uncomment and set to tune for real
# target hardware — do not guess values; so-sndbuf/so-rcvbuf must not exceed
# this host's net.core.rmem_max/wmem_max (Linux) or Aeron will fail to create
# the publication/subscription. term-length must be a power of two, min 64KB.
# AERON_TERM_LENGTH=
# AERON_MTU=
# AERON_SO_SNDBUF=
# AERON_SO_RCVBUF=
