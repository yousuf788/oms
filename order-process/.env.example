# Single-computer example — all services on one machine (localhost).
# Copy to `.env` for local dev: cp .env.example .env
# Run three order-process terminals with NODE_ID=1, 2, 3.

BIND_HOST=0.0.0.0

# All three S2 replicas on the same host
NODE1_HOST=127.0.0.1
NODE1_NAME=Nitin
NODE1_RAFT_PORT=6001
NODE1_ORDER_PORT=7001
NODE1_HEALTH_PORT=6101

NODE2_HOST=127.0.0.1
NODE2_NAME=Amit
NODE2_RAFT_PORT=6002
NODE2_ORDER_PORT=7002
NODE2_HEALTH_PORT=6102

NODE3_HOST=127.0.0.1
NODE3_NAME=Yousuf
NODE3_RAFT_PORT=6003
NODE3_ORDER_PORT=7003
NODE3_HEALTH_PORT=6103

# order-receiver on the same machine
S3_HOST=127.0.0.1
S3_PORT=8001

HEARTBEAT_INTERVAL_MS=50
ELECTION_TIMEOUT_MIN_MS=150
ELECTION_TIMEOUT_MAX_MS=300

# This demo profile doesn't run order-witness, so single-node self-promotion falls
# back to the legacy blind-timeout behavior (identical to before witness support was
# added). To try the witness-corroborated path locally: also run
# `cd order-witness && cp .env.example .env && cargo run --release`, set
# WITNESS_HOST=127.0.0.1 below, and flip this to true.
REQUIRE_WITNESS_FOR_SINGLE_NODE_LEADER=false
