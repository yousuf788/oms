# order-receiver bind config
# Copy: cp .env.example .env

BIND_HOST=0.0.0.0
S3_PORT=8001

# S2 (order-process) cluster addresses — needed to broadcast REPLAY_REQUEST
# for the S2<->S3 gap-recovery protocol (order-receiver doesn't track Raft
# leadership, so it asks all 3 nodes; only the current leader responds).
# Must match order-process/.env's NODE*_HOST and NODE*_REPLAY_PORT exactly.
NODE1_HOST=10.10.1.121
NODE1_REPLAY_PORT=6201

NODE2_HOST=10.10.0.56
NODE2_REPLAY_PORT=6202

NODE3_HOST=10.10.1.69
NODE3_REPLAY_PORT=6203

# Must match order-process/.env's CLUSTER_HMAC_KEY — order-receiver now
# verifies the result channel's HMAC and signs its own replay requests with it.
CLUSTER_HMAC_KEY=b3c85adea50f9c53173a6adace2568825f34c46645c4c0711eb45b96dad3246e
