# order-receiver bind config
# Copy: cp .env.example .env

BIND_HOST=0.0.0.0
S3_PORT=8001

# S2 (order-process) cluster addresses — needed to broadcast REPLAY_REQUEST
# for the S2<->S3 gap-recovery protocol (order-receiver doesn't track Raft
# leadership, so it asks all 3 nodes; only the current leader responds).
# Must match order-process/.env.example's NODE*_HOST and NODE*_REPLAY_PORT.
NODE1_HOST=127.0.0.1
NODE1_REPLAY_PORT=6201

NODE2_HOST=127.0.0.1
NODE2_REPLAY_PORT=6202

NODE3_HOST=127.0.0.1
NODE3_REPLAY_PORT=6203

# Must match order-process's CLUSTER_HMAC_KEY — order-receiver now verifies
# the result channel's HMAC and signs its own replay requests with it.
# Generate with: openssl rand -hex 32
CLUSTER_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# ── Optional Aeron channel tuning (all unset by default = Media Driver defaults) ──
# See order-process/.env.example for the full explanation; same four vars,
# same caveats (so-sndbuf/so-rcvbuf capped by this host's OS sysctls).
# AERON_TERM_LENGTH=
# AERON_MTU=
# AERON_SO_SNDBUF=
# AERON_SO_RCVBUF=
