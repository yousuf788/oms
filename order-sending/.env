# Multi-machine cluster sample for order-sending
# Copy to `.env` or reuse order-process/.env values for NODE*_HOST.

BIND_HOST=0.0.0.0
SENDER_BIND_PORT=9001

NODE1_HOST=10.10.1.121
NODE1_ORDER_PORT=7001

NODE2_HOST=172.16.13.181
NODE2_ORDER_PORT=7002

NODE3_HOST=172.16.12.252
NODE3_ORDER_PORT=7003

# 300k orders/sec throughput test
TARGET_TPS=300000
SENDER_THREADS=32
