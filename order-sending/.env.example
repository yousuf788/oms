# order-sending — same cluster hosts as order-process
# Copy: cp .env.example .env   (or copy order-process/.env)

BIND_HOST=0.0.0.0
SENDER_BIND_PORT=9001

NODE1_HOST=127.0.0.1
NODE1_ORDER_PORT=7001

NODE2_HOST=127.0.0.1
NODE2_ORDER_PORT=7002

NODE3_HOST=127.0.0.1
NODE3_ORDER_PORT=7003

# ── HMAC Authentication (REQUIRED) ─────────────────────────────────────
# Every Aeron order message is signed with CLUSTER_HMAC_KEY.
# This MUST match the value set in order-process/.env on every node.
# Generate once and copy to all machines:
#   openssl rand -hex 32
CLUSTER_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32
