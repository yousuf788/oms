# order-sending — same cluster hosts as order-process
# Copy: cp .env.example .env   (or copy order-process/.env)

BIND_HOST=0.0.0.0
# Also the bind address for the replay listener that serves REPLAY_REQUEST
# from order-process (S1<->S2 gap-recovery protocol) — order-process nodes
# need this reachable at S1_HOST:S1_REPLAY_PORT (see order-process/.env).
SENDER_BIND_PORT=9001

NODE1_HOST=127.0.0.1
NODE1_ORDER_PORT=7001

NODE2_HOST=127.0.0.1
NODE2_ORDER_PORT=7002

NODE3_HOST=127.0.0.1
NODE3_ORDER_PORT=7003

# ── HMAC Authentication (REQUIRED) ─────────────────────────────────────
# Every Aeron order message is signed with CLUSTER_HMAC_KEY.
# This MUST match the value set in order-process/.env on every node.
# Generate once and copy to all machines:
#   openssl rand -hex 32
CLUSTER_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# ── Optional Aeron channel tuning (all unset by default = Media Driver defaults) ──
# See order-process/.env.example for the full explanation; same four vars,
# same caveats (so-sndbuf/so-rcvbuf capped by this host's OS sysctls).
# AERON_TERM_LENGTH=
# AERON_MTU=
# AERON_SO_SNDBUF=
# AERON_SO_RCVBUF=
