# Multi-machine cluster sample for order-sending
# Copy to `.env` or reuse order-process/.env values for NODE*_HOST.

BIND_HOST=0.0.0.0
SENDER_BIND_PORT=9001

NODE1_HOST=172.16.12.104
NODE1_ORDER_PORT=7001

NODE2_HOST=10.10.0.56
NODE2_ORDER_PORT=7002

NODE3_HOST=10.10.1.69
NODE3_ORDER_PORT=7003

# Required — same value as order-process's CLUSTER_HMAC_KEY on every machine.
# Generate with: openssl rand -hex 32
CLUSTER_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32
