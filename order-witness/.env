# order-witness config — deploy and run on Yousuf's machine (172.16.12.252), the
# currently-idle third node slot, so it fails independently of Vivek's and Amit's
# machines. Must match order-process/.env's NODE*_HOST / NODE*_HEALTH_PORT exactly.

BIND_HOST=0.0.0.0
WITNESS_PORT=9101

NODE1_HOST=10.10.1.121
NODE1_HEALTH_PORT=6101

NODE2_HOST=172.16.13.181
NODE2_HEALTH_PORT=6102

NODE3_HOST=172.16.12.252
NODE3_HEALTH_PORT=6103

WITNESS_POLL_INTERVAL_MS=500
WITNESS_PROBE_TIMEOUT_MS=400
WITNESS_PROBE_RETRIES=1
VERBOSE_WITNESS=false
