# Single-computer example — matches order-process/.env.example (all localhost).
# Copy to `.env` for local dev: cp .env.example .env

BIND_HOST=0.0.0.0
WITNESS_PORT=9101

# Must match order-process/.env's NODE*_HOST and NODE*_HEALTH_PORT exactly.
NODE1_NAME=Nitin
NODE1_HOST=127.0.0.1
NODE1_HEALTH_PORT=6101

NODE2_NAME=Amit
NODE2_HOST=127.0.0.1
NODE2_HEALTH_PORT=6102

NODE3_NAME=Yousuf
NODE3_HOST=127.0.0.1
NODE3_HEALTH_PORT=6103

WITNESS_POLL_INTERVAL_MS=500
WITNESS_PROBE_TIMEOUT_MS=400
WITNESS_PROBE_RETRIES=1
VERBOSE_WITNESS=false

# ── HMAC Authentication (REQUIRED) ──────────────────────────────────────────
# WITNESS_HMAC_KEY authenticates corroboration messages. Must be IDENTICAL to
# the WITNESS_HMAC_KEY in order-process/.env on every cluster node.
# Generate once and copy to all machines that run either order-witness or
# order-process:
#   openssl rand -hex 32
WITNESS_HMAC_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32
